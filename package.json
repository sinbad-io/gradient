{
  "name": "gradient",
  "version": "0.1.0",
  "description": "Nature-like gradients for React: photographs of light through paper, one per seed.",
  "license": "MIT",
  "author": "Oscar Antonio Borlund Orellana",
  "repository": "github:sinbad-io/gradient",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tiles/*": "./tiles/*"
  },
  "files": [
    "dist",
    "src",
    "tiles"
  ],
  "scripts": {
    "build": "node scripts/tiles.mjs && tsc",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.7.3"
  }
}
